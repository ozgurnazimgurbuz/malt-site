        "@id": "https://maltstudio.co/hizmetler/totem/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Totem ile pylon farkı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Pylon genelde daha yüksek yol sistemidir. Aynı ailede ele alınır; ayrı doorway URL açılmaz."
            }
          },
          {
            "@type": "Question",
            "name": "İzin gerekir mi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Konuma göre değişir. İzin riski keşifte konuşulur; süre garanti edilmez."
            }
          },
          {
            "@type": "Question",
            "name": "Işıklı totem?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet, gece yaklaşım için ışıklı üretilebilir. LED servis erişimi tasarımda bırakılır."
            }
          },
          {
            "@type": "Question",
            "name": "Temel kim yapar?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Saha planına göre koordinasyon sağlanır. Temel tipi zemin koşullarına bağlıdır."
            }
          },
          {
            "@type": "Question",
            "name": "Indoor totem?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Taşınabilir indoor display Display & POS ailesindedir. Bu sayfa outdoor tesis/yol totemidir."
            }
          },
          {
            "@type": "Question",
            "name": "OSB montajı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet, planlı keşif ile. Vinç ve güvenlik penceresi keşif notuna yazılır."
            }
          },
          {
            "@type": "Question",
            "name": "Süre?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Temel ve üretime bağlıdır. Temel kürü takvime yazılır."
            }
          },
          {
            "@type": "Question",
            "name": "Bakım?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Bağlantı ve yüzey kontrolü önerilir. Işıklıysa LED servis erişimi korunmalıdır."
            }
          }
        ]
      }
