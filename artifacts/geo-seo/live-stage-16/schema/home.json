      {
        "@id": "https://maltstudio.co/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Tekirdağ’da tabela ve reklam işi yapıyor musunuz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet. Malt Studio Tekirdağ Süleymanpaşa merkezlidir; tabela, ışıklı tabela, kutu harf, totem, cam ve araç giydirme üretimi ile montajını aynı hatta planlarız."
            }
          },
          {
            "@type": "Question",
            "name": "Keşif ücretli mi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Keşif randevusu WhatsApp veya telefon ile alınır. Ölçü ve saha notları teklifi şekillendirir; sabit internet fiyatı yayınlanmaz."
            }
          },
          {
            "@type": "Question",
            "name": "Süleymanpaşa ve çevre ilçelere geliyor musunuz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet. Süleymanpaşa, merkez ve çevre ilçe işleri Tekirdağ atölyesinden planlanır. Detay için atölye ve iletişim sayfasına bakın."
            }
          },
          {
            "@type": "Question",
            "name": "Hangi tabela türünü seçmeliyim?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Gece görünürlük için ışıklı tabela , cephe yazısı için kutu harf , genel üretim için tabela imalatı sayfalarına bakın."
            }
          },
          {
            "@type": "Question",
            "name": "Çalışma saatleriniz nedir?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Pazartesi–Cumartesi 09:00–19:00. Keşif ve montaj randevusu WhatsApp veya telefon ile alınır. Adres ve yol tarifi Tekirdağ atölye sayfasında ."
            }
          }
        ]
      }
