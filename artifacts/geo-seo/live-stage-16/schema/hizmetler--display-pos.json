      {
        "@id": "https://maltstudio.co/hizmetler/display-pos/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Roll-up vs X-banner?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Roll-up kasalı sistemdir; X-banner daha ekonomik ve daha hassas taşınır. Seçim kullanım süresine göre yapılır."
            }
          },
          {
            "@type": "Question",
            "name": "Fuar standı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tekil display burada planlanır. Tam fuar standı veya backdrop ayrıca değerlendirilir."
            }
          },
          {
            "@type": "Question",
            "name": "Indoor totem?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Taşınabilir indoor display bu ailededir. Yol ve tesis totemi totem sayfasındadır."
            }
          },
          {
            "@type": "Question",
            "name": "Adet avantajı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Toplu siparişte teklif özeldir. Peşin birim oran ilan edilmez."
            }
          },
          {
            "@type": "Question",
            "name": "Baskı kalitesi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Okunur mesafe ve çözünürlük planlanır. Onaylı görsel olmadan baskı başlamaz."
            }
          },
          {
            "@type": "Question",
            "name": "Teslimat?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Donanım ve baskı birlikte teslim edilebilir."
            }
          },
          {
            "@type": "Question",
            "name": "Süre?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Genelde kısa döngü; adet ve baskı tipine göre netlenir."
            }
          },
          {
            "@type": "Question",
            "name": "Yeniden baskı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Aynı kasaya yeni baskı yapılabilir. Kampanya yenilemesi için kasa saklanır."
            }
          }
        ]
      }
