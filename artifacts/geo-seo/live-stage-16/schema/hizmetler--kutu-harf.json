      {
        "@id": "https://maltstudio.co/hizmetler/kutu-harf/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Pleksi mi paslanmaz mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Bütçe, mimari ve bakım beklentisine göre değişir. Karşılaştırma: kutu harf malzemeleri ."
            }
          },
          {
            "@type": "Question",
            "name": "Channel letters nedir?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Kutu harfin uluslararası adıdır. Ayrı URL yoktur; üretim bu sayfadadır."
            }
          },
          {
            "@type": "Question",
            "name": "Işıklı olur mu?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet, modele göre LED’li üretilir. Işıklı/ışıksız tercih üretimden önce netleşir."
            }
          },
          {
            "@type": "Question",
            "name": "Font şart mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vektörel logo veya font dosyası kaliteyi yükseltir. Font lisansı müşteri sorumluluğundadır."
            }
          },
          {
            "@type": "Question",
            "name": "Montaj her yüzeye olur mu?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hayır. Kompozit, beton ve cam farklı aparat ister; keşif şarttır."
            }
          },
          {
            "@type": "Question",
            "name": "Bakım?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Dış ortamda periyodik kontrol önerilir. Işıklı harflerde servis erişimi korunmalıdır."
            }
          },
          {
            "@type": "Question",
            "name": "Süre?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Harf adedi ve malzemeye göre değişir; teklifte yazılır."
            }
          },
          {
            "@type": "Question",
            "name": "Ofis içi logo?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ofis içi 3D logo ofis branding paketiyle birlikte planlanabilir."
            }
          }
        ]
      }
