            "@type": "FAQPage",
            "@id": "https://maltstudio.co/hizmetler/cam-giydirme/#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "One way vision nedir?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Dışarıdan grafik görünen, içeriden bakışa izin veren delikli folyodur. Rehber: one way vision nedir ."
                }
              },
              {
                "@type": "Question",
                "name": "İçerisi kararır mı?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Folyo tipine ve delik oranına göre ışık geçirgenliği değişir. Karanlık mağazada görüş zayıflayabilir."
                }
              },
              {
                "@type": "Question",
                "name": "Araç camı?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Araç camı araç giydirme kapsamında değerlendirilir."
                }
              },
              {
                "@type": "Question",
                "name": "Sökülür mü?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Kampanya sonunda kontrollü söküm planlanır. Kirli cama uygulama kenar/hava hatası yapar."
                }
              },
              {
                "@type": "Question",
                "name": "Buğu / yapışma?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Cam hazırlığı ve doğru gergi kritiktir."
                }
              },
              {
                "@type": "Question",
                "name": "Ofis paketi?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Ofis gizlilik folyosu ofis branding paketiyle birlikte yönetilebilir; malzeme bilgisi bu sayfadadır."
                }
              },
              {
                "@type": "Question",
                "name": "Süre?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Çoğu vitrin işi kısa sürer; ölçü ve katman sayısına göre netlenir."
                }
              },
              {
                "@type": "Question",
                "name": "Tasarım?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Mesaj hiyerarşisi okunur tutulur. Aşırı kalabalık vitrin grafiği ürün yerine gürültü üretir."
                }
              }
            ]
          }
        ]
      }
