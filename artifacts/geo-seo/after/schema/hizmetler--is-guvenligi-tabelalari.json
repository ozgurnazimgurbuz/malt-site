      {
        "@id": "https://maltstudio.co/hizmetler/is-guvenligi-tabelalari/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Yangın çıkışı burada mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet. Yangın çıkışı, acil çıkış ve toplanma alanı bu ailededir."
            }
          },
          {
            "@type": "Question",
            "name": "Yönlendirme aynı mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hayır. Oda/kat wayfinding bu ailenin H1’i değildir; iş güvenliği uyarı setidir."
            }
          },
          {
            "@type": "Question",
            "name": "ISO belgesi veriyor musunuz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hayır. Malt Studio tabela üretir ve tedarik eder; belgelendirme kuruluşu değildir."
            }
          },
          {
            "@type": "Question",
            "name": "Toplu set?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Listeye veya Excel’e göre üretilir. Toplu saha etiketleme OSB ve depoda sık istenir."
            }
          },
          {
            "@type": "Question",
            "name": "Dış mekân dayanım?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Malzeme sahaya göre seçilir. UV ve darbe ihtiyacı keşifte konuşulur."
            }
          },
          {
            "@type": "Question",
            "name": "Montaj?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Saha planıyla yapılır. Üretim hattı duruşu varsa takvim ona göre yazılır."
            }
          },
          {
            "@type": "Question",
            "name": "Süre?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Standart setlerde hızlıdır; özel metin onayına bağlıdır."
            }
          },
          {
            "@type": "Question",
            "name": "Özel uyarı metni?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet, onaya göre. Tıbbi veya yasal danışmanlık yerine geçmez."
            }
          }
        ]
      }
