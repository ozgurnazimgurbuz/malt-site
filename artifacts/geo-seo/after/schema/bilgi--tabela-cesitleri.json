        "mainEntity": [
          {
            "@type": "Question",
            "name": "Bu yazıdan sipariş verilir mi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hayır; eğitimdir. Tabela siparişi tabela üretimi sayfasındadır."
            }
          },
          {
            "@type": "Question",
            "name": "En doğru tabela hangisi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Konum, gece ihtiyacı ve bütçeye göre değişir. Tek cevap yoktur; tablo türleri ayırır."
            }
          },
          {
            "@type": "Question",
            "name": "Tekirdağ’da kim uygular?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Keşif Tekirdağ atölyesinden planlanır. WhatsApp veya telefon yeterlidir."
            }
          },
          {
            "@type": "Question",
            "name": "İlgili hizmet nerede?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Üretim ve teklif Tabela sayfasındadır."
            }
          },
          {
            "@type": "Question",
            "name": "Daha fazla rehber?",
