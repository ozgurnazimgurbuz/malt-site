        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Işıklı tabeladan farkı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Cephe LED tabela ışıklı tabela sayfasındadır. Bu sayfa lightbox kutu ve çerçeve ailesidir."
            }
          },
          {
            "@type": "Question",
            "name": "SEG nedir?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Silikon kenarlı kumaş germe sistemidir. Görsel değişim sıklığı yüksekse avantaj sağlar."
            }
          },
          {
            "@type": "Question",
            "name": "Görsel değişir mi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "SEG’de hızlı kumaş değişimi mümkündür. LED değişimi ayrı kalemdir."
            }
          },
          {
            "@type": "Question",
            "name": "İnce kasa?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Mekâna göre kasa tipi seçilir. İnce görünüm elektrik ve soğutma ile dengelenir."
            }
          },
          {
            "@type": "Question",
            "name": "Servis?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "LED ve kumaş değişimi planlanır. Servis kapsamı teklifte yazılır."
            }
          },
          {
            "@type": "Question",
            "name": "Süre?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ölçü ve kasa tipine göre netlenir."
            }
          },
          {
            "@type": "Question",
            "name": "Fiyat?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ölçü, kasa ve baskı. Sabit liste yoktur."
            }
          },
          {
            "@type": "Question",
            "name": "Tekirdağ’da keşif?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet. Keşif Tekirdağ atölyesinden planlanır."
            }
          }
        ]
      }
