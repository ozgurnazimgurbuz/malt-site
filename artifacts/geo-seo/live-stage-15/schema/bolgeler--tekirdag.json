        "@id": "https://maltstudio.co/bolgeler/tekirdag/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Atölye nerede?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yavuz Mahallesi, Ruşen Güneş Sokak, D Blok No:2, 59100 Süleymanpaşa / Tekirdağ, Türkiye."
            }
          },
          {
            "@type": "Question",
            "name": "Çalışma saatleri?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Pazartesi–Cumartesi 09:00–19:00."
            }
          },
          {
            "@type": "Question",
            "name": "Süleymanpaşa ayrı sayfa mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hayır; Süleymanpaşa talepleri bu atölye sayfasında toplanır."
            }
          },
          {
            "@type": "Question",
            "name": "Keşif nasıl alınır?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "WhatsApp veya telefon ile kısa brief bırakın. Keşif sonrası yazılı teklif çıkar."
            }
          },
          {
            "@type": "Question",
            "name": "Hangi hizmetler Tekirdağ’dan planlanır?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tabela, ışıklı tabela, kutu harf, totem, cam ve araç giydirme, lightbox, display, ofis branding ve iş güvenliği tabelaları. Liste: hizmetler ."
            }
          },
          {
            "@type": "Question",
            "name": "Çevre ilçelere geliyor musunuz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Süleymanpaşa ve Tekirdağ merkez başta olmak üzere çevre ilçe işleri aynı atölyeden planlanır."
            }
          }
        ]
      }
