      {
        "@id": "https://maltstudio.co/hizmetler/isikli-tabela/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "LED tabela neon mu?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hayır. Neon ayrı formdur. Bu sayfadaki ışıklı tabela LED kasa sistemidir."
            }
          },
          {
            "@type": "Question",
            "name": "Lightbox istiyorum?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Lightbox ayrı üründür: lightbox . Cephe LED tabela bu sayfadadır."
            }
          },
          {
            "@type": "Question",
            "name": "Elektrik hazır değilse?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Keşifte altyapı ihtiyacı konuşulur. Hat yoksa teklife altyapı kalemi yazılır."
            }
          },
          {
            "@type": "Question",
            "name": "Servis ve arıza?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "LED ve güç kaynağı servisi için iletişime geçilir. Peşin ömür boyu vaadi yoktur."
            }
          },
          {
            "@type": "Question",
            "name": "Fiyatı neye göre?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ölçü, LED, yüzey ve montaj koşulları. Sabit liste yoktur; keşif sonrası yazılı teklif."
            }
          },
          {
            "@type": "Question",
            "name": "Su ve toz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Dış mekân kasalarında sızdırmazlık planı keşifte konuşulur."
            }
          },
          {
            "@type": "Question",
            "name": "Gece çok mu parlak olur?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "LED yoğunluğu cepheye göre ayarlanır; aşırı parlaklık okunurluğu bozar."
            }
          },
          {
            "@type": "Question",
            "name": "Süre?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Onay sonrası ölçeğe göre netlenir ve teklifte yazılır."
            }
          }
        ]
      }
