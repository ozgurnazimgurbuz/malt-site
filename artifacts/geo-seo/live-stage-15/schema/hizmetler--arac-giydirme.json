      {
        "@id": "https://maltstudio.co/hizmetler/arac-giydirme/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Boya zarar görür mü?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Doğru folyo ve uygulamada kontrollü söküm hedeflenir. Araç boyasının durumu sonucu etkiler; peşin ‘boya bozulmaz’ garantisi verilmez."
            }
          },
          {
            "@type": "Question",
            "name": "Full mu parça mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Bütçe ve görünür alana göre. Parça giydirme çoğu filoda yeterlidir; full wrap zorunlu değildir."
            }
          },
          {
            "@type": "Question",
            "name": "Filo indirimi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Toplu işlerde kurumsal teklif hazırlanır. Peşin oran ilan edilmez."
            }
          },
          {
            "@type": "Question",
            "name": "Süre?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tek araçta genelde kısa; filoda planlı takvim. Ortam sıcaklığı uygun değilse iş ertelenir."
            }
          },
          {
            "@type": "Question",
            "name": "Cam giydirme ayrı mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Araç camı bu kapsamdadır. Bina camı cam giydirme sayfasındadır."
            }
          },
          {
            "@type": "Question",
            "name": "Tasarım?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Marka kılavuzuna göre uyarlanır. Araç listesi ve fotoğraf olmadan şablon çıkmaz."
            }
          },
          {
            "@type": "Question",
            "name": "Kışın uygulanır mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ortam sıcaklığı uygunsa. Uygun değilse iş ertelenir; kalitesiz yapışma riski alınmaz."
            }
          },
          {
            "@type": "Question",
            "name": "Ömür?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Folyo tipi, yıkama, güneş ve kullanıma bağlıdır. Sayısal ömür vaadi verilmez."
            }
          }
        ]
      }
