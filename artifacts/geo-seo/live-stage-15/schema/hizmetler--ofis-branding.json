      {
        "@id": "https://maltstudio.co/hizmetler/ofis-branding/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Kapı isimliği dahil mi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Pakete eklenebilir. Standart set varsayılmaz; brief’te netleştirilir."
            }
          },
          {
            "@type": "Question",
            "name": "Cam giydirme ayrı mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Malzeme ve uygulama cam giydirme uzmanlığıyla bağlanır; ofis paketi bu sayfadadır."
            }
          },
          {
            "@type": "Question",
            "name": "İç mekan giydirme farkı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Bu sayfa workplace paketidir: resepsiyon, lobi, toplantı, kat kimliği. Her mekân duvar giydirmesi ayrı aile olarak açılmaz."
            }
          },
          {
            "@type": "Question",
            "name": "Kesinti olur mu?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Mesai dışı veya düşük yoğunluklu pencere planlanabilir. Plaza kuralları keşifte sorulur."
            }
          },
          {
            "@type": "Question",
            "name": "Logo dosyası?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vektörel tercih edilir. Font lisansı müşteri sorumluluğundadır."
            }
          },
          {
            "@type": "Question",
            "name": "Süre?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Alan büyüklüğüne ve onay süresine göre. Yönetim onayı gecikirse takvim kayar."
            }
          },
          {
            "@type": "Question",
            "name": "Plaza yönetimi onayı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Gerekirse keşifte konuşulur. Onaysız cephe işi risklidir."
            }
          },
          {
            "@type": "Question",
            "name": "Fiyat?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Alan, malzeme ve erişim. Sabit liste yoktur."
            }
          }
        ]
      }
