        "@type": "BreadcrumbList"
      },
      {
        "@id": "https://maltstudio.co/hizmetler/tabela/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Tabela ile ışıklı tabela farkı nedir?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Işıklı tabela gece görünürlük için LED’li sistemdir. Ayrı sayfa: ışıklı tabela . Bu sayfa genel tabela üretimini kapsar."
            }
          },
          {
            "@type": "Question",
            "name": "Montajı siz yapıyor musunuz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet. Üretim atölyede, montaj sahada birlikte planlanır."
            }
          },
          {
            "@type": "Question",
            "name": "Fiyat listesi var mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hayır. Ölçü, malzeme ve montaj keşiften sonra yazılı netleşir. Sabit internet fiyatı yayınlanmaz."
            }
          },
          {
            "@type": "Question",
            "name": "Tekirdağ dışında çalışıyor musunuz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tekirdağ üssünden çevre ilçelere keşif ve montaj planlanır. Atölye: Tekirdağ iletişim ."
            }
          },
          {
            "@type": "Question",
            "name": "Ne kadar sürer?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Onay ve ölçüye göre birkaç iş gününden birkaç haftaya değişir. Süre teklifte yazılır; tutulmayan süre vaadi yoktur."
            }
          },
          {
            "@type": "Question",
            "name": "Tasarım desteği var mı?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Marka dosyanız yoksa sade ve okunur tasarım önerisi sunulur. Vektörel logo kaliteyi yükseltir."
            }
          },
          {
            "@type": "Question",
            "name": "Eski tabela sökümü?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yenileme işlerinde söküm ve yüzey rötuşu planlanabilir; peşin dahil varsayılmaz."
            }
          },
          {
            "@type": "Question",
            "name": "Garanti?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Malzeme ve işçilik kapsamı teklifte yazılı netleştirilir. Peşin ‘ömür boyu’ vaadi yoktur."
            }
          }
        ]
      }
